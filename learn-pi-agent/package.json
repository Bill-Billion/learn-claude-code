{
  "name": "learn-pi-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "s01": "node --env-file-if-exists=.env s01_agent_loop/code.ts",
    "s02": "node --env-file-if-exists=.env s02_tool_schema/code.ts",
    "s03": "node --env-file-if-exists=.env s03_provider_events/code.ts",
    "s04": "node --env-file-if-exists=.env s04_evented_tool_loop/code.ts",
    "s05": "node --env-file-if-exists=.env s05_tool_hooks/code.ts",
    "s06": "node --env-file-if-exists=.env s06_turn_state/code.ts",
    "s07": "node --env-file-if-exists=.env s07_session_tree/code.ts",
    "s08": "node --env-file-if-exists=.env s08_context_resources/code.ts",
    "s09": "node --env-file-if-exists=.env s09_extension_runtime/code.ts",
    "s10": "node --env-file-if-exists=.env s10_runtime_modes/code.ts",
    "s11": "node --env-file-if-exists=.env s11_project_trust/code.ts",
    "s12": "node --env-file-if-exists=.env s12_pi_package/code.ts",
    "s13": "node --env-file-if-exists=.env s13_integrated_harness/code.ts",
